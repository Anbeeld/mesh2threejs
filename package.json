{
  "name": "mesh2threejs",
  "version": "0.4.0",
  "description": "Live-oracle to independently authored procedural Three.js reconstruction pipeline",
  "type": "module",
  "bin": {
    "mesh2threejs": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "styles",
    "profiles",
    "skills",
    "adapters",
    "agents",
    "docs",
    "examples",
    "fixtures",
    "benchmarks",
    "tools",
    "AGENTS.md",
    "CLAUDE.md",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx benchmarks/geometry.bench.ts",
    "validate": "npm run validate:development",
    "validate:development": "npm run check && npm run test:coverage && npm run build && npm run validate:artifacts",
    "validate:artifacts": "node dist/validation/artifacts.js",
    "test:e2e": "node dist/validation/e2e.js",
    "prepack": "npm run validate:development"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pngjs": "7.0.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.185.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
